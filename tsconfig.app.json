{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@i18n/*": [
        "./Modules/I18n/resources/*"
      ],
      "@auth/*": [
        "./Modules/Auth/resources/*"
      ],
      "@databases/*": [
        "./Modules/Databases/resources/*"
      ]
    }
  },
  "include": [
    "src",
    "Modules/*/resources/js"
  ]
}
