{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@i18n/*": [
        "./Modules/I18n/resources/*"
      ],
      "@auth/*": [
        "./Modules/Auth/resources/*"
      ],
      "@server/*": [
        "./Modules/Server/resources/*"
      ],
      "@databases/*": [
        "./Modules/Databases/resources/*"
      ],
      "@roles/*": [
        "./Modules/Roles/resources/*"
      ],
      "@status/*": [
        "./Modules/Status/resources/*"
      ],
      "@schemas/*": [
        "./Modules/Schemas/resources/*"
      ],
      "@tables/*": [
        "./Modules/Tables/resources/*"
      ],
      "@views/*": [
        "./Modules/Views/resources/*"
      ],
      "@sequences/*": [
        "./Modules/Sequences/resources/*"
      ],
      "@routines/*": [
        "./Modules/Routines/resources/*"
      ],
      "@types/*": [
        "./Modules/Types/resources/*"
      ],
      "@replication/*": [
        "./Modules/Replication/resources/*"
      ],
      "@export/*": [
        "./Modules/Export/resources/*"
      ],
      "@import/*": [
        "./Modules/Import/resources/*"
      ],
      "@maintenance/*": [
        "./Modules/Maintenance/resources/*"
      ],
      "@sql/*": [
        "./Modules/Sql/resources/*"
      ]
    }
  },
  "include": [
    "src",
    "Modules/*/resources/js"
  ]
}
